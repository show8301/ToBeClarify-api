# Local .NET SDK installed for this workspace
.dotnet/
.dotnet-home/
dotnet-install.sh

# Build output
bin/
obj/
publish/

# Documentation and database scripts are kept outside the API repository
*.[mM][dD]
*.[sS][qQ][lL]

# Keep collaboration-facing API documentation in the repository.
!README.md
!docs/
!docs/**/*.md

# Keep versioned database migrations as the schema source of truth.
!db/
!db/migrations/
!db/migrations/**/*.sql

# Runtime media files are deployed separately and must not be committed
/media/

# One-time developer-issued tokens
oneTimeToken.txt
oneTimeToken.txt.lock
registerKey.txt
registerKey.txt.lock

# Temporary tools and probe projects created during local development
.codex-tmp/

# Runtime logs
Logs/
**/Logs/
*.log

# Test and coverage output
TestResults/
coverage/
*.trx

# IDE files
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Local secrets (never commit)
appsettings.Local.json
*.publishsettings
*.pfx

# OS files
.DS_Store
