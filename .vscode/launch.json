{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (ToBeClarify API)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net10.0/ToBeClarify.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5075",
                "DOTNET_CLI_HOME": "${workspaceFolder}/.dotnet-home",
                "NUGET_PACKAGES": "${workspaceFolder}/.dotnet-home/.nuget/packages"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        }
    ]
}
